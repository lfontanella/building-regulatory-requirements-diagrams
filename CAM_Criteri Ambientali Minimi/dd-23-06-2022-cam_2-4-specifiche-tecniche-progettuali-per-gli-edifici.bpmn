      <bpmn:text>valore medio</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1xhm9ag">
      <bpmn:text>valore ottimale</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dxx1zt">
      <bpmn:text>n50: differenza di pressione di 50 Pa</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1piivlx">
      <bpmn:text>Nel caso di impossibilità, va giustificato dal progettista in Rel. Tecnica</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ut31i4">
      <bpmn:text>valore minimo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1x0r3eg">
      <bpmn:text>RF - campi magnetici
ad alta frequenza</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0md0r1o">
      <bpmn:text>ELF - campi magnetici
a bassa frequenza</bpmn:text>
    </bpmn:textAnnotation>
